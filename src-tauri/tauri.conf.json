{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peak Music Player",
  "version": "1.0.0",
  "identifier": "hu.tottoszoltan.peakmusic",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Mozgó, szinkronizált dalszöveg a Spotifyhoz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}